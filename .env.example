# PostgreSQL 17 connection. URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional for TLS through the Timeweb database domain: base64-encoded PEM CA certificate.
# DATABASE_SSL_CA_BASE64=
# Optional when the server certificate is trusted by the system CA store.
# DATABASE_SSL=require

# Admin credentials. Keep the real values in Timeweb App Platform variables, not in Git.
HATTI_ADMIN_USER=Hatti_admin32
HATTI_ADMIN_SALT=replace-with-existing-salt
HATTI_ADMIN_HASH=replace-with-existing-password-hash
HATTI_ADMIN_SESSION_KEY=replace-with-existing-session-key
