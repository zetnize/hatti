# Supabase PostgreSQL connection from Dashboard > Connect > Session pooler.
# URL-encode special characters in the password. Do not use the project URL or publishable key here.
DATABASE_URL=postgresql://postgres.tdzunzgxqaupjmlyjeqp:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Optional: base64-encoded PEM CA certificate for verified TLS.
# DATABASE_SSL_CA_BASE64=
# Use when the Supabase server CA is already trusted by the system.
# DATABASE_SSL=require

# Admin credentials. Keep the real values in Timeweb App Platform variables, not in Git.
HATTI_ADMIN_USER=Hatti_admin32
HATTI_ADMIN_SALT=replace-with-existing-salt
HATTI_ADMIN_HASH=replace-with-existing-password-hash
HATTI_ADMIN_SESSION_KEY=replace-with-existing-session-key
